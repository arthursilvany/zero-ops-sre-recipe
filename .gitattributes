# Deterministic line-ending normalization.
# CRLF in YAML and shell scripts has caused silent failures in reference projects.
* text=auto eol=lf

*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.ps1    text eol=lf
*.sh     text eol=lf
*.bicep  text eol=lf
*.tf     text eol=lf
*.tfvars text eol=lf
*.kql    text eol=lf

# Git hooks are executed by /bin/sh. A CRLF shebang makes the hook fail with a
# confusing "bad interpreter" error, which on a security hook would look like a
# broken tool rather than an unprotected push.
tools/hooks/* text eol=lf
.gitleaks.toml text eol=lf

# The POSIX shim has no extension, so the rules above do not reach it. A CRLF
# shebang here would surface as "bad interpreter" on every Linux caller.
bin/zeroops text eol=lf

# Immutable evidence and binary artifacts
*.html -text
*.docx binary
*.xlsx binary
*.png  binary
