# Secrets — never commit
*.env
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
secrets.json
local.settings.json
appsettings.*.local.json
.azure/
.credentials/

# Upstream secrets-file pattern (FR-49, SEC-013). The pinned upstream template
# layer writes connector credentials to 'connectors.secrets.env' next to the
# recipe being deployed, and its own recipes also ignore '*.secrets.env'.
# Because the upstream tree is fetched into a consumer's working directory
# rather than vendored, that file can land anywhere. Ignoring the pattern on
# day one costs nothing; discovering it after a push costs a history rewrite.
connectors.secrets.env
*.secrets.env
.parameters.json
.extras.json

# Discovery output (SEC-007). Read-only discovery writes a subscription-wide
# inventory of real resource identifiers, names and tags. Tags are a well-known
# place operators stash connection strings, so this is an identifier leak path
# whether or not it contains a credential. It is ignored by default; a redacted
# copy is what gets attached to a bug report.
.zeroops/
*.discovery.json

# Customer vocabulary: plaintext and salt must NEVER be committed.
# ADR-0006 stores only salted digests; the plaintext lives outside this
# repository. A committed denylist would be the disclosure the control exists
# to prevent, so it is ignored here and additionally fails the scan rule
# 'zeroops-plaintext-denylist' in .gitleaks.toml.
denylist.txt
deny-list.txt
blocklist.txt
forbidden-terms.*
*.vocabulary.txt
*.denylist.salt

# Infrastructure as Code state and local artifacts
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
.terraform/
.terraform.lock.hcl
crash.log
*.bicepparam.local

# Build, run output and volatile evidence
# NOTE: 'bin/' is deliberately NOT ignored. In this repository bin/ holds the
# committed 'zeroops' entry-point shims, not build output. Ignoring it would
# silently drop them from every commit.
out/
obj/
dist/
tmp/
*.log
*.tmp

# Upstream template layer, fetched and verified at run time rather than vendored
# (ADR-0001). Never commit a fetched copy: it would become an unpinned fork.
deploy/upstream/

# Tooling caches
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/
.ruff_cache/

# Operating system
Thumbs.db
desktop.ini
.DS_Store

# NOTE: 'prd.md' is deliberately NOT ignored. It is the brief this framework
# was built against, it is declared in contracts/core-paths.json as a present
# repository-meta path, and it is tracked, so an ignore line here would change
# nothing while telling the next reader the file is excluded. It was reviewed
# against the public-repository constraint and carries no secret material, no
# tenant identifier and no customer name; the local paths and the reference
# implementation's name were replaced with placeholders. Removing it from the
# tip would break the core declaration.

