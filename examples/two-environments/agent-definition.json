    "deploymentRef": "model-deployment"
  },
  "consumptionLimit": {
    "maxToolCalls": 200,
    "maxWallClockSeconds": 900
  },
  "capabilities": [
    "readResourceMetadata",
    "readMetrics",
    "readLogs",
    "readAlerts"
  ]
}
